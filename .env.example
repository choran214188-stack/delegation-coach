# LLM Provider 선택 (openai | anthropic | mock). 비워두면 키 존재로 자동 판별됩니다.
LLM_PROVIDER=openai

# --- OpenAI (기본 사용) ---
# OpenAI API Key. 비어 있으면 자동으로 예시(Mock) 모드로 동작합니다.
OPENAI_API_KEY=
# 사용할 모델 (기본값 gpt-4o-mini — 가장 저렴한 축).
# 더 저렴하게: gpt-4.1-nano (계정에서 사용 가능한 경우)
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic (선택) ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
